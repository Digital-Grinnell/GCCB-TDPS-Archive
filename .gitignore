# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore mac files 
.DS_Store

# temporarily ignore gemfile.lock
Gemfile.lock

# Ignore utility scripts
*.py
chat.json
chat_output.txt
CSV_TRANSFORMATION_SUMMARY.txt

# Ignore objects directory to avoid committing binary files (other than demo files)
# if you would like to commit your objects to github, delete the line below!
objects/
!objects/markdown/

# Account for DART files and large that should not be in the remote!
.DART-working-directory/
logfiles/*
csvdiff_*
DART_*
dart_settings.json
*.html